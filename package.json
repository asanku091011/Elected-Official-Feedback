{
  "name": "civlink",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --experimental-default-type=module --test \"tests/*.test.mjs\"",
    "build:web": "expo export --platform web && node scripts/finalize-web.mjs",
    "finalize:web": "node scripts/finalize-web.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.19",
    "expo-clipboard": "~58.0.4",
    "expo-status-bar": "~58.0.4",
    "qrcode-generator": "^1.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0"
  },
  "private": true
}
